{
  "name": "workflow_write_value",
  "description": "把上一个任务读取的值写入 TextEdit",
  "max_steps": 8,
  "max_duration_seconds": 45,
  "setup_steps": [
    {
      "type": "open_app",
      "app": "文本编辑"
    },
    {
      "type": "press",
      "keys": ["command", "n"]
    }
  ],
  "steps": [
    {
      "type": "write",
      "content": "工作流值：${display_value}"
    },
    {
      "type": "verify_vision",
      "prompt": "文稿中是否显示工作流值：${display_value}？只返回 true 或 false。"
    },
    {
      "type": "done",
      "summary": "工作流变量传递完成"
    }
  ],
  "cleanup_steps": [
    {
      "type": "close_document",
      "app": "文本编辑",
      "save_changes": false
    },
    {
      "type": "activate_app",
      "app": "计算器"
    },
    {
      "type": "press",
      "keys": ["command", "w"]
    }
  ]
}
