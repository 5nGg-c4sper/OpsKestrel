{
  "name": "workflow_read_value",
  "description": "打开计算器并读取显示值",
  "max_steps": 5,
  "max_duration_seconds": 30,
  "steps": [
    {
      "type": "open_app",
      "app": "计算器"
    },
    {
      "type": "click_element",
      "app": "计算器",
      "element": {
        "role": "AXButton",
        "text": "7"
      }
    },
    {
      "type": "read_element",
      "app": "计算器",
      "element": {
        "role": "AXStaticText"
      },
      "read_attribute": "value",
      "output": "display_value"
    },
    {
      "type": "done",
      "summary": "计算器值已读取"
    }
  ]
}
