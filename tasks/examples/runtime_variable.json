{
  "name": "runtime_variable",
  "description": "从计算器读取显示值并输入到 TextEdit",
  "max_steps": 12,
  "max_duration_seconds": 60,
  "steps": [
    {
      "type": "open_app",
      "app": "计算器"
    },
    {
      "type": "click_element",
      "app": "计算器",
      "element": {
        "role": "AXButton",
        "text": "7"
      }
    },
    {
      "type": "read_element",
      "app": "计算器",
      "element": {
        "role": "AXStaticText"
      },
      "read_attribute": "value",
      "output": "display_value"
    },
    {
      "type": "open_app",
      "app": "文本编辑"
    },
    {
      "type": "press",
      "keys": ["command", "n"]
    },
    {
      "type": "write",
      "content": "计算器值：${display_value}"
    },
    {
      "type": "verify_vision",
      "prompt": "文稿中是否显示计算器值：${display_value}？只返回 true 或 false。"
    },
    {
      "type": "done",
      "summary": "运行时变量传递完成"
    }
  ],
  "cleanup_steps": [
    {
      "type": "close_document",
      "app": "文本编辑",
      "save_changes": false
    },
    {
      "type": "activate_app",
      "app": "计算器"
    },
    {
      "type": "press",
      "keys": ["command", "w"]
    }
  ]
}
