{
  "name": "calculator_17x23",
  "description": "计算 17*23 并确认结果为 391",
  "app": "计算器",
  "max_steps": 8,
  "max_duration_seconds": 60,
  "steps": [
    {
      "type": "open_app",
      "app": "计算器"
    },
    {
      "type": "write",
      "content": "17*23"
    },
    {
      "type": "press",
      "keys": ["enter"]
    },
    {
      "type": "verify_vision",
      "prompt": "计算器是否显示结果 391？只返回 true 或 false。"
    },
    {
      "type": "done",
      "summary": "17 * 23 = 391"
    }
  ]
}
